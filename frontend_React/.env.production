# Read by `npm run build` only -- `npm run dev` ignores this file and uses the
# localhost fallback in api.js instead.
#
# Fill this in with the ApiUrl that `sam deploy` prints, then rebuild. The
# value is baked into the JS bundle at build time, so changing it means
# building and re-uploading, not just restarting something.
VITE_API_URL=https://REPLACE-ME.execute-api.us-east-1.amazonaws.com/api
