# Read by `npm run build` only. `npm run dev` ignores this file and falls back
# to http://127.0.0.1:8000/api, so local development is unaffected.
#
# A relative path, not a full URL: CloudFront serves the page and the API from
# the same domain, so the browser resolves /api against whatever host it is
# already on. That is what makes this same-origin -- and why CORS no longer
# applies to the deployed site at all.
VITE_API_URL=/api
